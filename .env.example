# Copy this file to .env and fill in local configuration.
# Never commit .env or put real credentials in this example.
DATABASE_URL=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=talinturo
PGUSER=postgres
PGPASSWORD=

# Generate a persistent secret with:
# .\backend\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
TALINTURO_SECRET_KEY=
TALINTURO_DEMO_MODE=false
TALINTURO_COOKIE_SECURE=false
TALINTURO_DATABASE=
FLASK_DEBUG=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/auth/google/callback
TALINTURO_FRONTEND_URL=http://127.0.0.1:5173
